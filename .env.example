# Reference only: the program reads process environment variables, not .env files.
JOURNAL_USERNAME=
JOURNAL_PASSWORD=
RURAL_USERNAME=
RURAL_PASSWORD=
IJCHM_USERNAME=
IJCHM_PASSWORD=

# Optional journal whitelist. Empty uses each enabled flag in journals_config.json.
JOURNALS_ENABLED=

# Email is enabled only when all three email fields are set.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Optional ServerChan channel.
SERVERCHAN_KEY=

# Set to 1 for an authenticated check without notifications.
JOURNAL_DISABLE_NOTIFICATIONS=

# Optional cache path; default is .journal-monitor/article_status_cache.json.
JOURNAL_CACHE_FILE=
